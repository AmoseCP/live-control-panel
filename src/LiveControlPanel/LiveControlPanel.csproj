<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LiveControlPanel</RootNamespace>
    <AssemblyName>LiveControlPanel</AssemblyName>
    <!--
      WinExe, not Exe: nothing is ever written to a console (Serilog is file-only by design), so
      the only thing a console window did was flash a black box at every logon. Stop the panel
      with Stop-Process or the scheduled task; there is no Ctrl+C to lose.
    -->
    <OutputType>WinExe</OutputType>
    <!--
      Must stay false. Late-bound COM access to the presentation program passes
      CultureInfo.CurrentCulture's LCID to IDispatch::GetIDsOfNames; under invariant globalization
      that is the invariant culture (LCID 127), which Office rejects with DISP_E_UNKNOWNNAME for
      valid members. Together with the IDispatch marshalling in WpsCom this is what makes the page
      counter and the next-slide preview work at all. Date formatting is unaffected — the places
      that matter pin InvariantCulture explicitly.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- wwwroot is embedded so the single-file exe needs no companion folder. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.68.0.3539" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LiveControlPanel.Tests" />
  </ItemGroup>

</Project>
